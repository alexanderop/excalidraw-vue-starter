{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "sources",
    ".aop-work",
    ".features-gen",
    "pnpm-lock.yaml",
    "AGENTS.md"
  ]
}
